# Backend Loktoré — copier en .env et renseigner (ne jamais committer .env)

# PostgreSQL — base hébergée localement au Burkina Faso (cf. plan §7.2 / §8)
DATABASE_URL="postgresql://loktore:loktore@localhost:5432/loktore?schema=public"

# Secrets JWT (256 bits minimum). Générer : openssl rand -hex 32
JWT_ACCESS_SECRET="changeme-access-secret-32-chars-minimum"
JWT_REFRESH_SECRET="changeme-refresh-secret-32-chars-minimum"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Clé de chiffrement au repos des données de santé (32 octets).
# Générer : openssl rand -hex 32
ENCRYPTION_KEY="changeme-encryption-key-64-hex-characters-0000000000000000000000"

# Notifications Web Push (optionnel) — générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@loktore.bf"

# Serveur
# IA — Claude API (optionnel, active analyse ordonnances + examens)
ANTHROPIC_API_KEY=""

PORT=4000
NODE_ENV=development

# Origine autorisée pour CORS (le frontend en dev)
CORS_ORIGIN="http://localhost:3000"
