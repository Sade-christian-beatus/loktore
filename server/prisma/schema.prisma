// Schéma Prisma — modèle de données Loktoré (cf. PLAN_TECHNIQUE.md §4)
// Données de santé sensibles : l'autorisation est appliquée dans la couche service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  doctor
  facility
  admin
}

enum FacilityType {
  hospital
  pharmacy
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  done
}

enum ConsentStatus {
  pending
  granted
  revoked
}

enum OrderStatus {
  pending
  accepted
  ready
  completed
  cancelled
}

enum PaymentStatus {
  processing
  succeeded
  failed
}

// Profil = compte utilisateur (remplace auth.users + profiles de Supabase)
model Profile {
  id                String   @id @default(uuid())
  email             String   @unique
  phone             String?  @unique
  passwordHash      String
  role              Role     @default(patient)
  fullName          String
  avatarUrl         String?
  preferredLanguage String   @default("fr")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  medicalRecord     MedicalRecord?
  doctor            Doctor?
  patientAppointments  Appointment[] @relation("PatientAppointments")
  doctorAppointments   Appointment[] @relation("DoctorAppointments")
  sentMessages      Message[]
  refreshTokens     RefreshToken[]
  patientConversations Conversation[] @relation("PatientConversations")
  doctorConversations  Conversation[] @relation("DoctorConversations")
  ownedFacilities      Facility[]     @relation("OwnedFacilities")
  pushSubscriptions    PushSubscription[]
  patientConsents      RecordConsent[] @relation("PatientConsents")
  doctorConsents       RecordConsent[] @relation("DoctorConsents")
  patientOrders        Order[]         @relation("PatientOrders")
}

model MedicalRecord {
  id                String   @id @default(uuid())
  patient           Profile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId         String   @unique
  bloodType         String?
  allergies         String[]
  chronicConditions String[]
  history           Json?
  updatedAt         DateTime @updatedAt
}

model Doctor {
  id              String     @id
  profile         Profile    @relation(fields: [id], references: [id], onDelete: Cascade)
  speciality      String
  facility        Facility?  @relation(fields: [facilityId], references: [id])
  facilityId      String?
  bio             String?
  isOnline        Boolean    @default(false)
  consultationFee Int        @default(0)
}

model Facility {
  id          String       @id @default(uuid())
  name        String
  type        FacilityType
  latitude    Float
  longitude   Float
  address     String?
  phone       String?
  onDuty      Boolean      @default(false)
  onDutyUntil DateTime?
  owner       Profile?     @relation("OwnedFacilities", fields: [ownerId], references: [id])
  ownerId     String?
  doctors     Doctor[]
  medications Medication[]
  orders      Order[]

  @@index([ownerId])
}

model Appointment {
  id          String            @id @default(uuid())
  patient     Profile           @relation("PatientAppointments", fields: [patientId], references: [id])
  patientId   String
  doctor      Profile           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  doctorId    String
  scheduledAt DateTime
  status      AppointmentStatus @default(pending)
  reason      String?
  createdAt   DateTime          @default(now())

  @@index([patientId])
  @@index([doctorId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  sender         Profile  @relation(fields: [senderId], references: [id])
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Medication {
  id         String   @id @default(uuid())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String
  name       String
  price      Int?
  inStock    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  orderItems OrderItem[]
}

// Commande de médicaments d'un patient auprès d'une pharmacie
model Order {
  id         String      @id @default(uuid())
  patient    Profile     @relation("PatientOrders", fields: [patientId], references: [id])
  patientId  String
  facility   Facility    @relation(fields: [facilityId], references: [id])
  facilityId String
  status     OrderStatus @default(pending)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
  payment    Payment?

  @@index([patientId])
  @@index([facilityId])
}

// Paiement Mobile Money d'une commande (Orange / Moov). Le traitement réel
// passe par un service serveur dédié (cf. PLAN §6) ; ici via un fournisseur
// abstrait (mock) remplaçable par l'API réelle.
model Payment {
  id         String        @id @default(uuid())
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String        @unique
  provider   String // 'orange' | 'moov' | 'mock'
  phone      String
  amount     Int
  reference  String
  status     PaymentStatus @default(processing)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model OrderItem {
  id           String     @id @default(uuid())
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  medication   Medication @relation(fields: [medicationId], references: [id])
  medicationId String
  quantity     Int        @default(1)
  priceAtOrder Int?
}

model HealthContent {
  id          String   @id @default(uuid())
  category    String
  title       String
  body        String
  mediaUrl    String?
  language    String   @default("fr")
  publishedAt DateTime @default(now())
}

// Conversation patient ↔ médecin (support de la messagerie)
model Conversation {
  id        String   @id @default(uuid())
  patient   Profile  @relation("PatientConversations", fields: [patientId], references: [id])
  patientId String
  doctor    Profile  @relation("DoctorConversations", fields: [doctorId], references: [id])
  doctorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
}

// Consentement d'un patient au partage de son dossier avec un médecin
// (tracé et révocable, cf. PLAN §7.4).
model RecordConsent {
  id        String        @id @default(uuid())
  patient   Profile       @relation("PatientConsents", fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  doctor    Profile       @relation("DoctorConsents", fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId  String
  status    ConsentStatus @default(pending)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
}

// Journal des accès aux dossiers médicaux (cf. PLAN §7.4 : qui, quand, quoi)
model MedicalAccessLog {
  id        String   @id @default(uuid())
  actorId   String
  patientId String
  action    String // 'read' | 'write'
  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([actorId])
}

// Abonnements Web Push (un appareil/navigateur par enregistrement)
model PushSubscription {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([profileId])
}

// Rapport/étude/donnée africaine collectée, vérifiée et publiée automatiquement
model AfricanReport {
  id          String    @id @default(uuid())
  title       String
  description String?
  source      String    // 'worldbank' | 'who' | 'reliefweb' | 'afdb' | 'manual'
  sourceUrl   String
  country     String    // code ISO alpha-2 ou 'ALL'
  countryName String
  category    String    // 'health' | 'economy' | 'education' | 'humanitarian' | 'environment' | 'other'
  reportedAt  DateTime
  fetchedAt   DateTime  @default(now())
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  published   Boolean   @default(false)
  releasedAt  DateTime?
  rawData     Json?
  language    String    @default("fr")
  tags        String[]

  @@index([country])
  @@index([category])
  @@index([source])
  @@index([verified, published])
}

// Historique des exécutions du pipeline de collecte
model AfricanReportJob {
  id          String   @id @default(uuid())
  source      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String   // 'running' | 'done' | 'error'
  fetched     Int      @default(0)
  verified    Int      @default(0)
  published   Int      @default(0)
  errorMsg    String?
}

// Jetons de rafraîchissement (révocables) pour la rotation des sessions
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
