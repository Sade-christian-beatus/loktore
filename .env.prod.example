# Variables de la pile de production (docker-compose.prod.yml).
# Copier en .env.prod et renseigner. NE JAMAIS committer .env.prod.

# Base de données
POSTGRES_USER=loktore
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=loktore

# Secrets (générer : openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# Notifications Web Push (générer : npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@loktore.bf

# Origine publique de la PWA (pour CORS / Socket.IO)
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080
